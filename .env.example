SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY
# Keep this server-only. Never send it to the browser or Vercel.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY

# Render sets these paths to its persistent disk in render.yaml.
# Set FRONTEND_ORIGINS on Render to the deployed Vercel origin.
# Set API_BASE_URL on Vercel to https://YOUR_RENDER_SERVICE.onrender.com/api.
# Signed video URLs ke liye fixed secret. Khali chhora to har restart par links toot jayenge.
VIDEO_URL_SECRET=

# Public contact email shown on the Privacy, Terms and landing pages (set the real address; nothing is shown if empty).
CONTACT_EMAIL=

# Free-tier limits (all optional)
CLEANUP_DAYS=3
DAILY_LIMIT=5
# Real render cap in seconds for EVERY account (admins too). Render keeps 35; the local Docker app uses 120.
# MAX_VIDEO_SECONDS=120
MAX_VIDEO_SECONDS=35
# Optional higher daily video count for premium users (default = DAILY_LIMIT). Picks batches are charged per video.
# PREMIUM_DAILY_LIMIT=25
DEFAULT_QUALITY=fast
MAX_ACTIVE_JOBS_PER_USER=1

# Ask AI (Quran-only answers via Google Gemini free tier). Without a key the page shows search results only.
LLM_API_KEY=
# A Flash / Flash-Lite model id from https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=
ASK_ENABLED=1
ASK_DAILY_LIMIT=5
ASK_GLOBAL_DAILY=200
